{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondate-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kondate-bot",
      // ローカル開発とテストでは使われない。本番は `wrangler d1 create kondate-bot` で得たIDに差し替える（人間が実行）
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
