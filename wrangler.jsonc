{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kondate-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // 公開URLは workers.dev の1本だけにする。バージョンごとのプレビューURLは作らない
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // LIFFを載せたLINEログインチャネルのチャネルID。認証情報ではない（IDトークン検証の audience）
    "LIFF_CHANNEL_ID": "2012765529"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kondate-bot",
      // 本番D1のID（`wrangler d1 create kondate-bot` の結果）。ローカル開発とテストでは使われない
      "database_id": "7bc0a1ee-865f-4d00-9756-35fd292dd41c",
      "migrations_dir": "migrations"
    }
  ]
}
